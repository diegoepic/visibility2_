# ============================================================
# Visibility2 — variables de entorno
#
# Copiar este archivo como .env EN LA RAIZ del proyecto y rellenar.
# El .env real NO se versiona (ver .gitignore).
#
# Lo leen app/con_.php y portal/con_.php a traves de lib_env.php.
# Una variable definida en el panel del hosting GANA sobre este archivo.
#
# Los valores de aqui son marcadores. No poner claves reales en este archivo:
# se versiona.
# ============================================================

# ---------- Base de datos (obligatorio) ----------
# Sin estas cuatro, el portal responde 503 y no arranca.
DB_HOST=localhost
DB_USER=CAMBIAR_usuario_bd
DB_PASSWORD=CAMBIAR_password_bd
DB_NAME=CAMBIAR_nombre_bd

# ---------- Seguridad (obligatorio) ----------
# APP_KEY firma la huella de sesion (session_fingerprint) y debe tener 16+
# caracteres. Si cambia, TODAS las sesiones activas se invalidan.
# Generar con: openssl rand -hex 32
APP_KEY=CAMBIAR_cadena_aleatoria_de_32_o_mas_caracteres

# Minutos de inactividad antes de cerrar sesion en el portal. Por defecto 60.
SESSION_INACTIVITY_MINUTES=60

# Dias que dura el "recordarme" del login de la app.
V2_REMEMBER_DAYS=30

# ---------- Google Maps y rutas ----------
# Clave del SDK de Maps en el navegador. Es publica por diseno: restringirla
# por referrer en la consola de Google, no ocultarla.
GOOGLE_MAPS_API_KEY=CAMBIAR_clave_maps_js

# Map ID VECTORIAL. Sin esto el mapa es raster y moveCamera() ignora en
# silencio tilt y heading, o sea no hay perspectiva 3D en la navegacion.
# Crear en Cloud Console como JavaScript + Rendering type: Vector.
GOOGLE_MAPS_MAP_ID=CAMBIAR_map_id_vectorial

# Clave de Routes API v2. Esta si es secreta: la usa el proxy
# app/api/route_compute.php del lado del servidor. Nunca al navegador.
GOOGLE_ROUTES_API_KEY=CAMBIAR_clave_routes_api

# URL del proxy de rutas. Vaciar para volver a llamadas directas a Google
# (rollback instantaneo si el proxy falla).
ROUTES_PROXY_URL=/visibility2/app/api/route_compute.php

# ---------- Correo ----------
# Remitente de los avisos de seguridad (bloqueo de cuenta, dispositivo nuevo).
# Debe ser un dominio con SPF y DKIM configurados o los correos caen en spam.
MAIL_FROM=no-reply@visibility.cl

# ---------- Odometro con IA (encuesta de vehiculos) ----------
OPENAI_API_KEY=CAMBIAR_clave_openai
GOOGLE_CLOUD_PROJECT=CAMBIAR_id_proyecto_gcp
GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/credenciales.json

# ---------- Reglas de negocio ----------
# Fecha desde la cual el ingreso es SOLO por RUT (formato YYYY-MM-DD).
# Ojo: solo afecta a la app. El portal usa la constante de lib_login_rut.php.
LOGIN_SOLO_RUT_DESDE=2026-09-01

# Horas tras las cuales una visita sin cerrar se considera huerfana.
VISITA_ORPHAN_HOURS=24

# ---------- Diagnostico ----------
# Version que se muestra en la app y se usa para depurar reportes de terreno.
APP_VERSION=1.0.0

# Habilita app/api/test_session.php. Dejar vacio o en 0 en produccion.
V2_TEST_MODE=0
